# Copy to .env to override values from config/env/<TEST_ENV>.env (TEST_ENV defaults to "local")
UI_BASE_URL=https://emicalculator.net/
API_BASE_URL=http://127.0.0.1:4010
API_PORT=4010
API_AUTO_START=true
HEADLESS=true
BROWSER=chromium
SLOW_MO_MS=0
UI_STEP_TIMEOUT_MS=90000
UI_ACTION_TIMEOUT_MS=20000
UI_TRACE=on-failure
UI_VIDEO=false
DATABASE_URL=postgres://localhost:5432/streamhub_qa
SELF_HEAL_PROVIDER=auto
SELF_HEAL_MODEL=claude-opus-5-5
