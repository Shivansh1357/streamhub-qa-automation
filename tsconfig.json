{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": "."
  },
  "ts-node": {
    "transpileOnly": true
  },
  "include": ["config/**/*.ts", "api/**/*.ts", "tests/**/*.ts", "tools/**/*.ts", "sql/**/*.ts"],
  "exclude": ["node_modules", "reports", "dist"]
}
